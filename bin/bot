#!/usr/bin/env ruby
# frozen_string_literal: true

require "logger"
require_relative "../lib/telegram_voice_bot"

TelegramVoiceBot::EnvLoader.load!(File.expand_path("../.env", __dir__))

$stdout.sync = true
logger = Logger.new($stdout)
logger.level = TelegramVoiceBot::Config.logger_level_from_env

begin
  config = TelegramVoiceBot::Config.from_env
  bot = TelegramVoiceBot::Bot.new(config: config, logger: logger)
  bot.run
rescue ArgumentError => e
  warn(e.message)
  warn("Copy .env.example to .env and set the required values before starting the bot.")
  exit 1
end
